---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerField from '../components/CareerField.astro';
import CareerPresentation from '../components/CareerPresentation.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import StudyPlan from '../components/StudyPlan.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`${site.program} | ${site.faculty} UABJO`}
  description={site.description}
>
  <StudyPlan />
  <Hero />
  <CareerPresentation />
  <CareerField />
  <Gallery />
</BaseLayout>
