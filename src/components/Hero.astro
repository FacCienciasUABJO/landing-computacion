---
import ButtonLink from './ButtonLink.astro';
import TagList from './TagList.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---

<section id="inicio" class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Facultad de Ciencias · UABJO</p>
      <h1>Licenciatura en <span>Computación</span></h1>
      <p class="hero__lead">
        Formación disciplinaria en programación e ingeniería de software, bases
        de datos, desarrollo web, arquitectura y redes, inteligencia artificial
        y matemáticas aplicadas.
      </p>
      <div class="hero__actions">
        <ButtonLink href="#carrera">Conoce la carrera</ButtonLink>
        <ButtonLink href={site.officialUrl} variant="secondary">
          Información oficial
        </ButtonLink>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__grid-pattern" aria-hidden="true"></div>
      <div class="hero__logo-plate">
        <img
          src={withBase('/logos/licenciatura-computacion.png')}
          alt="Logotipo de la Licenciatura en Computación"
          width="150"
          height="151"
        />
      </div>
      <div class="hero__areas">
        <TagList label="Áreas de formación" items={site.areas} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    position: relative;
    max-width: 46rem;
  }

  .hero__copy::before {
    display: block;
    width: 3.5rem;
    height: 4px;
    margin-bottom: 1.25rem;
    border-radius: 999px;
    background: var(--color-accent);
    content: "";
  }

  .hero h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
  }

  .hero h1 span {
    color: var(--color-primary);
  }

  .hero__lead {
    max-width: 60ch;
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero__visual {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-surface);
  }

  .hero__grid-pattern {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(1 48 128 / 7%) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(1 48 128 / 7%) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 85%);
    mask-image: linear-gradient(to bottom, #000, transparent 85%);
  }

  .hero__logo-plate {
    display: grid;
    place-items: center;
    width: min(100%, 15rem);
    margin-inline: auto;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: var(--color-bg);
    box-shadow: 0 12px 30px rgb(3 5 62 / 8%);
  }

  .hero__logo-plate img {
    width: 9.5rem;
    height: auto;
  }

  .hero__areas {
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      max-width: 34rem;
    }
  }

  @media (max-width: 640px) {
    .hero__actions :global(.button) {
      width: 100%;
    }

    .hero__logo-plate img {
      width: 8rem;
    }
  }
</style>
