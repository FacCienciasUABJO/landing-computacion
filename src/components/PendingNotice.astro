---
interface Props {
  title?: string;
  body: string;
  links?: readonly { label: string; href: string }[];
}

const {
  title = 'Información pendiente de confirmación',
  body,
  links = [],
} = Astro.props;
---

<aside class="pending-notice" aria-label={title}>
  <p class="pending-notice__badge">{title}</p>
  <p class="pending-notice__body">{body}</p>
  {links.length > 0 && (
    <div class="pending-notice__links">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>
  )}
</aside>

<style>
  .pending-notice {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 0.75rem 0.75rem 0;
    background: var(--color-bg);
  }

  .pending-notice__badge {
    display: inline-block;
    margin: 0 0 0.6rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--color-accent-tint);
    color: var(--color-primary-deep);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pending-notice__body {
    max-width: 70ch;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .pending-notice__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.9rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
