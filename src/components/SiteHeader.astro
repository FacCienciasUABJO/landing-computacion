---
import { navItems, site } from '../data/site';
import { withBase } from '../utils/paths';
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-brand" href={withBase('/')}>
      <img
        src={withBase('/logos/facultad-ciencias.png')}
        alt="Escudo de la Facultad de Ciencias de la UABJO"
        width="44"
        height="44"
      />
      <span class="site-brand__text">
        <strong>{site.program}</strong>
        <span>{site.faculty} · UABJO</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      data-menu-toggle
      aria-controls="menu-principal"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <span class="menu-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <nav
      class="site-nav"
      id="menu-principal"
      data-open="false"
      aria-label="Navegación principal"
    >
      {navItems.map((item) => (
        <a class="site-nav__link" href={item.href}>{item.label}</a>
      ))}
      <a class="site-nav__cta" href={site.officialUrl}>Sitio oficial</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = header.querySelector<HTMLElement>('#menu-principal');
    const desktop = window.matchMedia('(min-width: 861px)');

    if (toggle && nav) {
      const setOpen = (open: boolean) => {
        nav.dataset.open = String(open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      };

      toggle.addEventListener('click', () => {
        setOpen(nav.dataset.open !== 'true');
      });

      nav.addEventListener('click', (event) => {
        if (event.target instanceof HTMLAnchorElement) {
          setOpen(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nav.dataset.open === 'true') {
          setOpen(false);
          toggle.focus();
        }
      });

      desktop.addEventListener('change', (event) => {
        if (event.matches) {
          setOpen(false);
        }
      });

      setOpen(false);
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 72px;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .site-brand img {
    flex: none;
    width: 44px;
    height: auto;
  }

  .site-brand__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.2;
  }

  .site-brand__text strong {
    color: var(--color-primary-deep);
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .site-brand__text span {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  .site-nav__link {
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .site-nav__link:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-primary);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--color-primary);
    border-radius: 0.5rem;
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .site-nav__cta:hover {
    background: var(--color-primary);
    color: #ffffff;
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
    cursor: pointer;
  }

  .menu-toggle__bars {
    display: grid;
    gap: 4px;
    width: 18px;
  }

  .menu-toggle__bars span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--color-primary-deep);
  }

  @media (max-width: 860px) {
    .site-header__inner {
      flex-wrap: wrap;
      padding-block: 0.55rem;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      width: 100%;
      max-height: calc(100dvh - 5rem);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-left: 0;
      padding: 0.5rem 0 1rem;
      overflow-y: auto;
      border-top: 1px solid var(--color-border);
    }

    .site-nav[data-open="true"] {
      display: flex;
    }

    .site-nav__link {
      padding: 0.8rem 0.25rem;
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav__cta {
      justify-content: center;
      margin-top: 0.75rem;
    }
  }
</style>
