---
interface Props {
  label: string;
  items: readonly string[];
}

const { label, items } = Astro.props;
---

<div class="tag-list">
  <p class="tag-list__label">{label}</p>
  <ul class="tag-list__items" aria-label={label}>
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .tag-list {
    display: grid;
    gap: 0.75rem;
  }

  .tag-list__label {
    color: var(--color-secondary);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tag-list__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list__items li {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-primary-deep);
    font-size: 0.78rem;
    line-height: 1.3;
  }
</style>
