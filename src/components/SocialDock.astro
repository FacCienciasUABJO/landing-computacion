---
import { site } from '../data/site';
---

<details class="social-dock" data-social-dock>
  <summary
    class="social-dock__toggle"
    aria-label="Abrir redes sociales de la Licenciatura en Computación"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"
      />
    </svg>
    <span class="social-dock__label">Redes</span>
  </summary>

  <div class="social-dock__panel">
    <p class="social-dock__title">Redes de la Licenciatura</p>
    {site.schoolSocial.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {link.label === 'Facebook' ? (
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            />
          </svg>
        ) : link.label === 'TikTok' ? (
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
            />
          </svg>
        ) : (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle
              cx="12"
              cy="12"
              r="4"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" />
          </svg>
        )}
        <span>
          {link.label}
          <span class="sr-only"> (se abre en una pestaña nueva)</span>
        </span>
      </a>
    ))}
  </div>
</details>

<script>
  const dock = document.querySelector<HTMLDetailsElement>('[data-social-dock]');

  if (dock) {
    const summary = dock.querySelector<HTMLElement>('summary');

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dock.open) {
        dock.open = false;
        summary?.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (
        dock.open &&
        event.target instanceof Node &&
        !dock.contains(event.target)
      ) {
        dock.open = false;
      }
    });

    dock.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        dock.open = false;
      });
    });
  }
</script>

<style>
  .social-dock {
    position: fixed;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    left: max(1rem, env(safe-area-inset-left, 0px));
    z-index: 60;
  }

  .social-dock__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-primary-deep);
    box-shadow: 0 8px 24px rgb(3 5 62 / 16%);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    list-style: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .social-dock__toggle::-webkit-details-marker {
    display: none;
  }

  .social-dock__toggle:hover,
  .social-dock[open] .social-dock__toggle {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #ffffff;
  }

  .social-dock__toggle svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .social-dock__panel {
    position: absolute;
    bottom: calc(100% + 0.6rem);
    left: 0;
    display: grid;
    gap: 0.2rem;
    width: 15rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-bg);
    box-shadow: 0 16px 40px rgb(3 5 62 / 18%);
  }

  .social-dock__title {
    margin: 0 0 0.4rem;
    padding-inline: 0.5rem;
    color: var(--color-secondary);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .social-dock__panel a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.5rem;
    border-radius: 0.5rem;
    color: var(--color-primary-deep);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .social-dock__panel a:hover {
    background: var(--color-primary-tint);
    color: var(--color-primary);
  }

  .social-dock__panel svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  @media (max-width: 480px) {
    .social-dock__label {
      display: none;
    }

    .social-dock__toggle {
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-dock__toggle {
      transition: none;
    }
  }
</style>
